# Copy ke .env lalu isi. JANGAN commit .env (sudah di .gitignore).
# Windows PowerShell: Copy-Item .env.example .env

# --- Backend (wajib untuk DB + auth) ---
# Pooled connection string dari Neon dashboard → Connect
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require
# Bebas, min 32 char acak. Contoh buat: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-string-acak-min-32-char

# --- Market data (opsional, V2 provider real) ---
# Kosongkan = simulator + CSV saja (news filter OFF by design di MVP)
MARKET_DATA_PROVIDER=
MARKET_DATA_API_KEY=

# --- Economic calendar provenance (V2 slice 15) ---
# Kosong = manual input only. Contoh: csv, manual, ics:https://..., api:vendor
ECONOMIC_CALENDAR_SOURCE=

# --- Dev store overrides (opsional) ---
# PAPER_STORE=data/paper.json

# --- Frontend (dibaca saat `npm run dev`, tanpa spasi di sekitar =) ---
NEXT_PUBLIC_API_URL=http://localhost:8001
